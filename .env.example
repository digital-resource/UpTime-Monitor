# ============================================================
# Monitoring Hub — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare Integration ──────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Rocket.net Integration ──────────────────────────────────
ROCKET_NET_API_KEY=
ROCKET_NET_TEAM_ID=

# ─── Webflow Integration ─────────────────────────────────────
# Create the App at https://webflow.com/dashboard/workspace/<slug>/app-development
# Requested scope must be exactly "sites:read" — no write/publish access.
# WEBFLOW_REDIRECT_URI must be the deployed app's URL + this exact path,
# registered verbatim (including scheme/trailing slash) in the Webflow App's
# redirect URI settings:
#   https://<your-production-domain>/api/integrations/webflow/callback
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=

# ─── Slack Integration ───────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_SIGNING_SECRET=

# ─── Mailgun ─────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# ─── Vercel Integration ──────────────────────────────────────
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# ─── GitHub Integration ──────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# ─── App Config ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Monitoring Hub

# ─── Monitoring Worker ───────────────────────────────────────
# Secret token for worker → app API calls
MONITORING_WORKER_SECRET=
# Cloudflare Worker base URL — used by /api/checks/trigger and /api/sync/trigger
WORKER_URL=
